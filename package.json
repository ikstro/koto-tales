{
  "name": "koto-tales",
  "private": true,
  "version": "0.1.0",
  "description": "A blocky 3D browser game whose stories are invented by a 6-year-old. Ukrainian voice-over, offline PWA.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "serve": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "voice": "node tools/voice/gen.mjs",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "shots": "node tools/check/shots.mjs",
    "perf": "node tools/check/perf.mjs",
    "hud": "node tools/hud/bake.mjs",
    "new": "node tools/new/new.mjs",
    "preview": "node tools/preview/preview.mjs"
  },
  "dependencies": {
    "simplex-noise": "^4.0.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.50.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
